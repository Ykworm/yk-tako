{
  "version": "2026-10-22",
  "source": "doc/19-v6/19v6-04-验收-curl.md",
  "note": [
    "本文件是契约字节的**机器真源**；doc/19-v6/19v6-04-验收-curl.md 是同一份内容的人读版。",
    "两份**同批改**。check-expected.sh 守两边的用例号集合一致。",
    "tier=core 的用例不需要模型，必须全过；tier=model 需要真实跑一轮（要 API Key 与网络）。",
    "expect 字段：http / code / message / data（子集比对：只断点名的键，值写 \"$any\" 是通配）/ data_keys（data 对象的键集与键序必须逐字相同）/ frame_kinds_contains / rows_len_equals。",
    "step 字段：method / path / body / auth / sql（请求前先跑的 SQL）/ capture（把响应里的值存成变量）/ op=signup（建账号+租户+配模型）/ op=wait_terminal（等这一场跑完）。"
  ],
  "cases": [
    {
      "id": "0-signup",
      "case": "用例 0",
      "tier": "core",
      "desc": "注册 → 账号/租户/成员/accessToken 一并回来",
      "steps": [
        {
          "op": "signup",
          "expect": {
            "http": 201,
            "code": 0,
            "message": "",
            "data_keys": [
              "user",
              "tenant",
              "membership",
              "accessToken",
              "tokenType",
              "expiresIn",
              "refreshToken"
            ]
          }
        }
      ]
    },
    {
      "id": "0-runtime-config",
      "case": "用例 0",
      "tier": "core",
      "desc": "租户配模型密钥 → 密钥回显成掩码",
      "steps": [
        {
          "op": "signup",
          "expect": {
            "http": 201,
            "code": 0,
            "message": ""
          }
        },
        {
          "method": "PUT",
          "path": "/api/tenants/{ten}/runtime-config",
          "body": {
            "modelRef": "deepseek/deepseek-flash",
            "mcpServers": {},
            "secrets": {
              "DEEPSEEK_API_KEY": "{key}"
            },
            "sandbox": {
              "network": false
            }
          },
          "expect": {
            "http": 200,
            "code": 0,
            "message": ""
          }
        }
      ]
    },
    {
      "id": "0-auth-required-runs",
      "case": "用例 0",
      "tier": "core",
      "desc": "业务四端点不带 Authorization 一律 401 信封",
      "steps": [
        {
          "method": "POST",
          "path": "/api/runs",
          "body": {
            "messageId": "m_x",
            "text": "hi"
          },
          "auth": false,
          "expect": {
            "http": 401,
            "code": 111102,
            "message": "请先登录",
            "data": null
          }
        },
        {
          "method": "GET",
          "path": "/api/sessions/s_nope",
          "auth": false,
          "expect": {
            "http": 401,
            "code": 111102,
            "message": "请先登录",
            "data": null
          }
        },
        {
          "method": "GET",
          "path": "/api/runs/r_nope/frames",
          "auth": false,
          "expect": {
            "http": 401,
            "code": 111102,
            "message": "请先登录",
            "data": null
          }
        },
        {
          "method": "GET",
          "path": "/api/sessions/s_nope/log",
          "auth": false,
          "expect": {
            "http": 401,
            "code": 111102,
            "message": "请先登录",
            "data": null
          }
        }
      ]
    },
    {
      "id": "0-model-not-configured",
      "case": "用例 0",
      "tier": "core",
      "desc": "租户没配模型密钥 → POST /api/runs 回 409 111408，run 起不来",
      "steps": [
        {
          "op": "signup",
          "no_model": true,
          "expect": {
            "http": 201,
            "code": 0,
            "message": ""
          }
        },
        {
          "method": "POST",
          "path": "/api/runs",
          "body": {
            "messageId": "m_1",
            "text": "hi"
          },
          "expect": {
            "http": 409,
            "code": 111408,
            "message": "这个工作区的模型还不可用",
            "data": null
          }
        }
      ]
    },
    {
      "id": "1-post-runs",
      "case": "用例 1",
      "tier": "model",
      "desc": "投递 → 202 + sessionId/runId/messageId",
      "steps": [
        {
          "method": "POST",
          "path": "/api/runs",
          "body": {
            "messageId": "m_v6",
            "text": "只回复 ok"
          },
          "capture": {
            "sid": "data.sessionId",
            "rid": "data.runId"
          },
          "expect": {
            "http": 202,
            "code": 0,
            "message": "",
            "data_keys": [
              "sessionId",
              "runId",
              "messageId"
            ]
          }
        }
      ]
    },
    {
      "id": "1-session-while-running",
      "case": "用例 1",
      "tier": "model",
      "desc": "跑中 GET /api/sessions/{sid} → 五个字段，顺序固定",
      "steps": [
        {
          "method": "POST",
          "path": "/api/runs",
          "body": {
            "messageId": "m_v6",
            "text": "只回复 ok"
          },
          "capture": {
            "sid": "data.sessionId",
            "rid": "data.runId"
          },
          "expect": {
            "http": 202,
            "code": 0,
            "message": "",
            "data_keys": [
              "sessionId",
              "runId",
              "messageId"
            ]
          }
        },
        {
          "method": "GET",
          "path": "/api/sessions/{sid}",
          "expect": {
            "http": 200,
            "code": 0,
            "message": "",
            "data_keys": [
              "liveRunId",
              "runlogOffset",
              "lastRunStatus",
              "lastRunId",
              "workspaceId"
            ]
          }
        }
      ]
    },
    {
      "id": "1-frames-and-log",
      "case": "用例 1",
      "tier": "model",
      "desc": "定稿后：frames 有 start/terminal，log 有 user+assistant 两行，session 变 complete",
      "steps": [
        {
          "method": "POST",
          "path": "/api/runs",
          "body": {
            "messageId": "m_v6",
            "text": "只回复 ok"
          },
          "capture": {
            "sid": "data.sessionId",
            "rid": "data.runId"
          },
          "expect": {
            "http": 202,
            "code": 0,
            "message": "",
            "data_keys": [
              "sessionId",
              "runId",
              "messageId"
            ]
          }
        },
        {
          "op": "wait_terminal",
          "run": "{rid}",
          "timeout": 90
        },
        {
          "op": "wait_settled",
          "session": "{sid}",
          "timeout": 30
        },
        {
          "method": "GET",
          "path": "/api/runs/{rid}/frames?eventOffset=0",
          "expect": {
            "http": 200,
            "code": 0,
            "message": "",
            "data_keys": [
              "frames",
              "nextOffset",
              "status"
            ],
            "frame_kinds_contains": [
              "start",
              "terminal"
            ]
          }
        },
        {
          "method": "GET",
          "path": "/api/sessions/{sid}",
          "expect": {
            "http": 200,
            "code": 0,
            "message": "",
            "data_keys": [
              "liveRunId",
              "runlogOffset",
              "lastRunStatus",
              "lastRunId",
              "workspaceId"
            ],
            "data": {
              "liveRunId": "",
              "lastRunStatus": "complete"
            }
          }
        },
        {
          "method": "GET",
          "path": "/api/sessions/{sid}/log?runlogOffset=0",
          "expect": {
            "http": 200,
            "code": 0,
            "message": "",
            "data_keys": [
              "rows",
              "nextOffset"
            ]
          }
        }
      ]
    },
    {
