    {
      "id": "1-frames-and-log",
      "case": "用例 1",
      "tier": "model",
      "desc": "定稿后：frames 有 start/terminal，log 有 user+assistant 两行，session 变 complete",
      "steps": [
        {
          "method": "POST",
          "path": "/api/runs",
          "body": {
            "messageId": "m_v6",
            "text": "只回复 ok"
          },
          "capture": {
            "sid": "data.sessionId",
            "rid": "data.runId"
          },
          "expect": {
            "http": 202,
            "code": 0,
            "message": "",
            "data_keys": [
              "sessionId",
              "runId",
              "messageId"
            ]
          }
        },
        {
          "op": "wait_terminal",
          "run": "{rid}",
          "timeout": 90
        },
        {
          "op": "wait_settled",
          "session": "{sid}",
          "timeout": 30
        },
        {
          "method": "GET",
          "path": "/api/runs/{rid}/frames?eventOffset=0",
          "expect": {
            "http": 200,
            "code": 0,
            "message": "",
            "data_keys": [
              "frames",
              "nextOffset",
              "status"
            ],
            "frame_kinds_contains": [
              "start",
              "terminal"
            ]
          }
        },
        {
          "method": "GET",
          "path": "/api/sessions/{sid}",
          "expect": {
            "http": 200,
            "code": 0,
            "message": "",
            "data_keys": [
              "liveRunId",
              "runlogOffset",
              "lastRunStatus",
              "lastRunId",
              "workspaceId"
            ],
            "data": {
              "liveRunId": "",
              "lastRunStatus": "complete"
            }
          }
        },
        {
          "method": "GET",
          "path": "/api/sessions/{sid}/log?runlogOffset=0",
          "expect": {
            "http": 200,
            "code": 0,
            "message": "",
            "data_keys": [
              "rows",
              "nextOffset"
            ]
          }
        }
      ]
