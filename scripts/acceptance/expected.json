    {
      "id": "3-unknown-session",
      "case": "用例 3",
      "tier": "core",
      "desc": "未知 sessionId：三个端点一律 404 112001",
      "steps": [
        {
          "method": "POST",
          "path": "/api/runs",
          "body": {
            "sessionId": "s_nope",
            "messageId": "m_9",
            "text": "hi"
          },
          "expect": {
            "http": 404,
            "code": 112001,
            "message": "找不到这场会话",
            "data": null
          }
        },
        {
          "method": "GET",
          "path": "/api/sessions/s_nope",
          "expect": {
            "http": 404,
            "code": 112001,
            "message": "找不到这场会话",
            "data": null
          }
        },
        {
          "method": "GET",
          "path": "/api/sessions/s_nope/log",
          "expect": {
            "http": 404,
