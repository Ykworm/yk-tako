    {
      "id": "3-unknown-run-frames",
      "case": "用例 3",
      "tier": "core",
      "desc": "未知 run 在 frames 上仍不是 404——200 + 空 frames + gone",
      "steps": [
        {
          "method": "GET",
          "path": "/api/runs/r_nope/frames",
          "expect": {
            "http": 200,
            "code": 0,
            "message": "",
            "data": {
              "frames": [],
              "nextOffset": 0,
              "status": "gone"
            },
            "data_keys": [
              "frames",
              "nextOffset",
              "status"
            ]
          }
        }
      ]
    },
    {
      "id": "4-busy-rejected",
      "case": "用例 4",
      "tier": "model",
      "needs": "pg",
      "desc": "忙时诚实拒绝：409 112101，且忙拒在 runlog 里零痕迹",
      "steps": [
        {
          "method": "POST",
          "path": "/api/runs",
          "body": {
            "messageId": "m_v6",
            "text": "只回复 ok"
          },
          "capture": {
            "sid": "data.sessionId",
            "rid": "data.runId"
          },
          "expect": {
            "http": 202,
            "code": 0,
            "message": ""
          }
        },
        {
          "op": "wait_terminal",
          "run": "{rid}",
          "timeout": 90
        },
        {
          "op": "wait_settled",
          "session": "{sid}",
          "timeout": 30
        },
        {
          "method": "GET",
          "path": "/api/sessions/{sid}/log?runlogOffset=0",
          "capture": {
            "rows_before": "data.rows"
          },
          "expect": {
            "http": 200,
            "code": 0,
            "message": ""
          }
        },
        {
          "sql": "UPDATE runs SET status='running', lease_until=now()+interval '5 minutes', finished_at=NULL WHERE id='{rid}'"
        },
        {
          "method": "POST",
          "path": "/api/runs",
          "body": {
            "sessionId": "{sid}",
            "messageId": "m_busy",
            "text": "急"
          },
          "expect": {
            "http": 409,
            "code": 112101,
            "message": "这场会话正在跑，等它跑完再发",
            "data": null
          }
        },
        {
          "sql": "UPDATE runs SET status='complete', lease_until=NULL, finished_at=now() WHERE id='{rid}'"
        },
        {
          "method": "GET",
          "path": "/api/sessions/{sid}/log?runlogOffset=0",
          "expect": {
            "http": 200,
            "code": 0,
            "message": "",
            "rows_len_equals": "{rows_before}"
          }
        }
      ]
    }
  ],
  "declared_not_asserted": {
    "用例 5": "单批上限 W —— 要用 -batch-window 3 特殊起引擎才造得出截断，默认 W=200 下这条断言没有意义；改引擎起法后手工重放",
    "用例 6": "工具循环（get_time）—— 断模型会不会真的去调工具，换个模型就飘；帧 kind 全集由 go test 的契约测试钉住",
    "用例 7": "委派子代理 —— 同上，模型是否委派不稳定；回传裁剪的机制断言在 doc/39 的活体抽验里",
    "用例 8": "任务看板的 task 帧 —— 要模型真的去调 TaskCreate/TaskUpdate 才造得出这条帧，模型行为不稳（换个模型就飘）；帧 kind 词表由 go test 的契约测试钉住，看板的持久化由 TestTaskBoardSurvivesProcessRestart 钉住（另一个 Store 实例读回同一批行）"
  }
}
