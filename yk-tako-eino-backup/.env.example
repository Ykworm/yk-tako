# 选哪个模型：厂商/模型。目录见 src/config/provider-catalog.json
# 只配了一个厂商时，也可以只写模型名（不必在目录里）。
TAKO_MODEL=deepseek/deepseek-v4-flash

# DeepSeek：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# 不填则用目录里的 https://api.deepseek.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 其他厂商：写上 Key，并把 TAKO_MODEL 改成该厂商的模型。
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MOONSHOT_API_KEY=
#   这一个 Key 同时对应 kimi-cn、kimi-intl、kimi-codingplan，必须写前缀：
#   TAKO_MODEL=kimi-cn/kimi-k2.5
# ZHIPU_API_KEY=
# DASHSCOPE_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
#   TAKO_MODEL=ollama/llama3

# 目录里没有的兼容接口：
# TAKO_PROVIDER_MYPROXY_API_KEY=
# TAKO_PROVIDER_MYPROXY_BASE_URL=https://example.com/v1
# TAKO_PROVIDER_MYPROXY_PROTOCOL=openai
# TAKO_MODEL=myproxy/模型名
