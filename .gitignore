# macOS 目录元数据
.DS_Store

# 本地工具产物（编辑器配置 / 文件快照）
.arts/
.merkle-snapshot.json

# 密钥与日志
.env
*.log

# 可视化头脑风暴会话产物（superpowers visual companion）
.superpowers/

# Go 编译产物（go build ./cmd/yktako 默认落在包目录）
yk-tako-eino/yktako

# 执行台账（planning.md / todos.md），用户验收完即清理，不进版本库
tmp/

# 运行时数据（-workspace 根：hist / notes / .tako / .media 落盘，进程写、可重建）
yk-tako-eino/workspace/

# MCP 本地配置：仓库只提交 mcp.example.json，真配置按机器各自复制
yk-tako-eino/mcp.json

# Python 字节码（scripts/acceptance 的工具跑起来会生成）
__pycache__/
